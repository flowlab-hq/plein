// Multi-layer EA sample for `autoLayout layers`.
// Declared bottom-up on purpose: band order must still be
// Motivation/Strategy → Business → Application → Technology → Implementation.
// Nested `grouping` stays one container in the Application band.
plein {
  model {
    work-package "Booking rollout" as rollout
    artifact "Order API" as orderApi
    node "NordFreight cloud" as cloud
    application-component "Rate engine" as rates
    application-component "TMS" as tms
    grouping "App platform" as platform
    business-service "Booking service" as booking
    business-actor "Shipper" as shipper
    capability "Network planning" as planning
    goal "On-time delivery" as onTime

    planning -> onTime: realization
    shipper -> booking: serving
    platform -> tms: aggregation
    platform -> rates: aggregation
    tms -> rates: flow
    booking -> tms: serving
    tms -> shipper: serving
    cloud -> tms: serving
    orderApi -> tms: serving
    rollout -> planning: realization
  }

  views {
    viewpoint layerBands "ArchiMate layer bands" {
      include onTime planning shipper booking platform tms rates cloud orderApi rollout
      autoLayout layers
      nesting nested
    }
  }
}
